# Required
OPENAI_API_KEY=sk-...

# Optional — defaults shown
# LEVEL1_MODEL=gpt-4o-mini
# OPENAI_ORG_ID=
# OPENAI_BASE_URL=

# Concurrency
# MAX_CONCURRENT_API_CALLS=8
# MAX_CONCURRENT_EVALUATIONS=4
# MAX_QUEUE_DEPTH=100

# Retry
# MAX_RETRIES=4
# RETRY_BASE_DELAY=1.0
# RETRY_MAX_DELAY=60.0

# Storage — empty = SQLite file next to package (screenings.db)
# DB_PATH=

# Triage thresholds (composite score, 0–100)
# TRIAGE_PASS_THRESHOLD=70
# TRIAGE_REVIEW_THRESHOLD=40
